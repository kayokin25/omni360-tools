# В репозитории держим LF, чтобы правки на разных машинах не давали шумных диффов.
* text=auto eol=lf

# Собранная панель — один длинный файл, построчный дифф по нему бесполезен.
dist/** -diff
source/** -diff

# Двоичные xlsx: без этого text=auto может решить, что файл текстовый, и
# нормализовать переводы строк внутри ZIP — испортит файл незаметно.
*.xlsx binary
*.xlsm binary
